@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(RinGPU CONFIG REQUIRED)
if(NOT TARGET RinGPU::RinGPUIpc)
  message(FATAL_ERROR
    "RinVulkan's installed RinOS process backend requires "
    "RinGPU::RinGPUIpc; install RinGPU with its RinOS IPC adapter enabled")
endif()
if(NOT TARGET RinVulkan::RinVulkan)
  include("${CMAKE_CURRENT_LIST_DIR}/RinVulkanTargets.cmake")
endif()
check_required_components(RinVulkan)
